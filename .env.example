# =============================================================================
# MILAN · Variables de entorno (copiar a .env.local y completar; NUNCA subir valores)
# =============================================================================

# Supabase — públicas (seguras en el navegador; protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://mxkiopzasbitismymvnf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SOLO SERVIDOR. Necesaria para crear usuarios y para el webhook de
# WhatsApp. Configúrala en Vercel como variable sin prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Dominio interno para convertir "usuario" en el email técnico de Supabase Auth
# (ej. blanca -> blanca@usuarios.milan.app). No se envían correos.
AUTH_USERNAME_DOMAIN=usuarios.milan.app

# WhatsApp Cloud API (Meta) — oficial. Dejar vacías hasta tener la cuenta.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# Versión de Graph API a usar
WHATSAPP_GRAPH_API_VERSION=v21.0
